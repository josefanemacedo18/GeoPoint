<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>GeoPoint.Revit</RootNamespace>
    <AssemblyName>GeoPoint.Revit</AssemblyName>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assemblies de referência da API do Revit 2027 (não são copiados para a saída). -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoPoint.Core\GeoPoint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GeoPoint.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
