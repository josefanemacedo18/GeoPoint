<Window x:Class="GeoPoint.Revit.UI.DesmembramentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GeoPoint.Revit.UI"
        x:Name="Root"
        Title="GeoPoint – Desmembramento" Width="1280" Height="860" MinWidth="1000" MinHeight="640"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="Desmembramento (divisão do lote)" Style="{StaticResource H1}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Label Content="Lote original:"/>
                <ComboBox x:Name="ParentBox" Width="320" DisplayMemberPath="Nome" SelectionChanged="Parent_Changed"/>
            </StackPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="Status" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="820"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True"/>
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="Registrar desmembramento" Style="{StaticResource Primary}" Click="Ok_Click"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Como dividir">
                        <StackPanel>
                            <RadioButton x:Name="ModeAuto" GroupName="m" IsChecked="True" Content="Automático (simular a divisão)" Checked="Any_Checked"/>
                            <RadioButton x:Name="ModeLines" GroupName="m" Content="Pelas linhas que desenhei no Revit" Checked="Any_Checked"/>
                            <RadioButton x:Name="ModeLots" GroupName="m" Content="Com lotes já reconhecidos" Checked="Any_Checked"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel x:Name="AutoPanel">
                        <Label Content="Frente (testada) – a divisão avança ao longo dela:"/>
                        <ComboBox x:Name="FrontBox" DisplayMemberPath="Text" SelectionChanged="Any_Changed"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FromStart" GroupName="side" IsChecked="True" Content="Começar pelo início da frente" Checked="Any_Checked"/>
                            <RadioButton x:Name="FromEnd" GroupName="side" Content="pelo fim" Checked="Any_Checked"/>
                        </StackPanel>
                        <GroupBox Header="Critério">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CEqual" GroupName="c" IsChecked="True" Content="Partes iguais:" Width="190" Checked="Any_Checked"/>
                                    <TextBox x:Name="Parts" Width="60" Text="2" TextChanged="Any_Text"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CArea" GroupName="c" Content="Mesma área por lote (m²):" Width="190" Checked="Any_Checked"/>
                                    <TextBox x:Name="Target" Width="80" Text="250" TextChanged="Any_Text"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CAreas" GroupName="c" Content="Área de cada lote (m²):" Width="190" Checked="Any_Checked"/>
                                    <TextBox x:Name="Areas" Width="170" Text="300; 250" TextChanged="Any_Text" ToolTip="Separe por ponto e vírgula. O que sobrar fica no último lote."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CFront" GroupName="c" Content="Mesma testada por lote (m):" Width="190" Checked="Any_Checked"/>
                                    <TextBox x:Name="Width1" Width="80" Text="10" TextChanged="Any_Text"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CFronts" GroupName="c" Content="Testada de cada lote (m):" Width="190" Checked="Any_Checked"/>
                                    <TextBox x:Name="Fronts" Width="170" Text="12; 12; 6" TextChanged="Any_Text" ToolTip="Separe por ponto e vírgula. O que sobrar fica no último lote."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Resto menor que (m²) vai para o último lote:"/>
                                    <TextBox x:Name="MinRem" Width="70" Text="125" TextChanged="Any_Text"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Direção das divisas">
                            <StackPanel>
                                <RadioButton x:Name="DirPerp" GroupName="d" IsChecked="True" Content="Perpendicular à frente" Checked="Any_Checked"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DirPar" GroupName="d" Content="Paralela à divisa:" Checked="Any_Checked"/>
                                    <ComboBox x:Name="ParBox" Width="230" DisplayMemberPath="Text" SelectionChanged="Any_Changed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DirAz" GroupName="d" Content="Azimute verdadeiro:" Checked="Any_Checked"/>
                                    <TextBox x:Name="AzText" Width="120" Text="0°00'00&quot;" TextChanged="Any_Text"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <StackPanel x:Name="LinesPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Hint}" Text="Desenhe as novas divisas no Revit com linhas de modelo ou de detalhe, do jeito que quiser (podem passar um pouco além do lote). Depois clique abaixo e selecione-as. As áreas são calculadas exatamente pelas linhas."/>
                        <Button Content="Selecionar linhas no Revit…" Margin="0,4,0,4" HorizontalAlignment="Left" Click="PickLines_Click"/>
                        <TextBlock x:Name="LinesInfo" Foreground="{StaticResource Muted}"/>
                    </StackPanel>

                    <StackPanel x:Name="LotsPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Hint}" Text="Lotes já reconhecidos dentro do lote original (marcados automaticamente)."/>
                        <ListBox x:Name="LotsList" Height="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Nome}" IsChecked="{Binding Selected}" Click="LotCheck_Click"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <GroupBox Header="Lotes resultantes">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Quadra:"/>
                                <TextBox x:Name="Quadra" Width="70"/>
                                <Label Content="  Numeração inicial:"/>
                                <TextBox x:Name="StartNumber" Width="60" Text="01" TextChanged="Any_Text"/>
                            </StackPanel>
                            <CheckBox x:Name="Sheets" IsChecked="True" Content="Gerar pranchas A4 (situação atual e proposta) ao registrar"/>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Observações:"/>
                                <TextBox x:Name="Notes" Width="290"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="240"/>
                </Grid.RowDefinitions>
                <ui:PreviewCanvas x:Name="Preview" Grid.Row="0" MinHeight="260"/>
                <TextBlock x:Name="Summary" Grid.Row="1" TextWrapping="Wrap" Margin="0,6,0,6"/>
                <DataGrid x:Name="Grid" Grid.Row="2" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Parte" Binding="{Binding Index}" Width="45" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nome / número" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding AreaText}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Testada (m)" Binding="{Binding TestadaText}" Width="75" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Remanescente" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Remanescente, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="Rem_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Proprietário (de quem é)" Binding="{Binding Proprietario, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTemplateColumn Header="Anexar a (remembrar)" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AnexarOptions, ElementName=Root}" DisplayMemberPath="Text" SelectedValuePath="Id"
                                              SelectedValue="{Binding AnexarA, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Perfil urbanístico" Binding="{Binding Situacao}" Width="140" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
