<Window x:Class="GeoPoint.Revit.UI.TraverseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GeoPoint.Revit.UI"
        Title="GeoPoint – Desenhar por azimutes e distâncias" Width="1220" Height="800" MinWidth="980" MinHeight="560"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Caminhamento: azimutes / rumos e distâncias" Style="{StaticResource H1}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Edite o modelo de texto abaixo (ou cole o texto de um memorial): o GeoPoint encontra os azimutes (ou rumos) e as distâncias enquanto você digita e mostra o desenho ao lado. Entrada em azimute verdadeiro; a coluna da direita mostra no formato configurado no projeto. Para arcos, informe o raio na tabela."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Desenhar" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Desenho">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModelLines" GroupName="lt" IsChecked="True" Content="Linhas de modelo"/>
                    <RadioButton x:Name="DetailLines" GroupName="lt" Content="Linhas de detalhe (vista atual)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="StartClick" GroupName="st" IsChecked="True" Content="Clicar no ponto inicial"/>
                    <RadioButton x:Name="StartRef" GroupName="st" Content="Começar no ponto de referência do projeto"/>
                </StackPanel>
                <CheckBox x:Name="Adjust" Content="Distribuir o erro de fechamento (método de Bowditch) e fechar o polígono" IsChecked="True" Click="Recalc_Click"/>
            </StackPanel>
        </GroupBox>
        <GroupBox DockPanel.Dock="Bottom" Header="Fechamento">
            <TextBlock x:Name="Result" FontFamily="Consolas" TextWrapping="Wrap"/>
        </GroupBox>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="170"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Column="2" Grid.RowSpan="3">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Prévia (norte para cima)" Margin="0,0,0,4"/>
                <Border BorderBrush="#DDD" BorderThickness="1"><ui:PreviewCanvas x:Name="Preview"/></Border>
            </DockPanel>
            <TextBox x:Name="Source" Grid.Row="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextChanged="Source_TextChanged" FontFamily="Consolas"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,6">
                <Button Content="Modelo de texto" Margin="0" Click="Template_Click" ToolTip="Insere um texto pronto para você só trocar os valores."/>
                <Button Content="Interpretar texto" Click="Parse_Click" Style="{StaticResource Primary}"/>
                <Button Content="Adicionar trecho" Click="Add_Click"/>
                <Button Content="Remover trecho" Click="Remove_Click"/>
                <Button Content="Recalcular" Click="Recalc_Click"/>
            </StackPanel>
            <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" CellEditEnding="Grid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Azimute (ex.: 299°36'55&quot;)" Binding="{Binding Az, UpdateSourceTrigger=LostFocus}" Width="170"/>
                    <DataGridTextColumn Header="Distância / corda (m)" Binding="{Binding Dist, UpdateSourceTrigger=LostFocus}" Width="130"/>
                    <DataGridTextColumn Header="Raio (m) – só arcos" Binding="{Binding Radius, UpdateSourceTrigger=LostFocus}" Width="120"/>
                    <DataGridCheckBoxColumn Header="Arco à direita" Binding="{Binding Right, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="No formato do projeto" Binding="{Binding Output}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Trecho encontrado no texto" Binding="{Binding Source}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
