<Window x:Class="GeoPoint.Revit.UI.SatelliteImagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoPoint – Imagens de satélite das pranchas" Width="760" Height="600" MinWidth="620" MinHeight="420"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Imagens de satélite" Style="{StaticResource H1}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                   Text="Escolha o print (ou a imagem salva) do local no satélite. A imagem fica guardada dentro do projeto e entra sozinha no espaço de localização das pranchas, recortada para preencher o espaço sem distorcer. A imagem geral vale para todas as pranchas; a de uma fase vale só para as pranchas dessa fase (sem ela, a fase usa a geral). Dica: tire o print (tecla Print Screen ou Win+Shift+S) e clique em Colar print."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#C9D1DB" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{Binding Back}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="{Binding ThumbW}" Height="{Binding ThumbH}" BorderBrush="#9AA4AE" BorderThickness="1" Background="#EEF0F3" VerticalAlignment="Top">
                                    <Grid>
                                        <Image Source="{Binding Thumb}" Stretch="Fill"/>
                                        <TextBlock Text="{Binding Empty}" Foreground="#8A939E" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"/>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#5F6B7A" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Escolher imagem…" Margin="0,0,6,4" Click="Pick_Click" Tag="{Binding}"
                                                ToolTip="PNG, JPG, BMP ou TIF (um print Full HD 1920×1080 é o ideal)."/>
                                        <Button Content="Colar print" Margin="0,0,6,4" Click="Paste_Click" Tag="{Binding}"
                                                ToolTip="Usa a imagem copiada (Print Screen, Win+Shift+S, ou Copiar imagem no navegador / Google Earth)."/>
                                        <Button Content="Remover" Margin="0,0,6,4" Click="Remove_Click" Tag="{Binding}" IsEnabled="{Binding HasOwn}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
