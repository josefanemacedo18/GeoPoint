<Window x:Class="GeoPoint.Revit.UI.SubdivisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoPoint" Width="820" Height="700" MinWidth="640" MinHeight="500"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock x:Name="Header" DockPanel.Dock="Top" Style="{StaticResource H1}"/>
        <TextBlock x:Name="Intro" DockPanel.Dock="Top" Style="{StaticResource Hint}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="Registrar" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Conferência">
            <TextBlock x:Name="Check" TextWrapping="Wrap"/>
        </GroupBox>
        <StackPanel DockPanel.Dock="Bottom" x:Name="ResultPanel">
            <GroupBox Header="Lote resultante">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Nome:"/>
                    <TextBox Grid.Column="1" x:Name="ResultName"/>
                    <Label Grid.Column="2" Content="  Quadra:"/>
                    <TextBox Grid.Column="3" x:Name="ResultQuadra"/>
                    <Label Grid.Column="4" Content="  Uso:"/>
                    <ComboBox Grid.Column="5" x:Name="ResultUse" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                    <Label Grid.Column="6" Content="  Matrícula:"/>
                    <TextBox Grid.Column="7" x:Name="ResultMatricula"/>
                </Grid>
            </GroupBox>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <CheckBox x:Name="Archive" IsChecked="True"/>
            <StackPanel Orientation="Horizontal">
                <Label Content="Observações:"/>
                <TextBox x:Name="Notes" Width="560"/>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" x:Name="ParentPanel">
            <Label Content="Lote original (a desmembrar):"/>
            <ComboBox x:Name="ParentBox" DisplayMemberPath="Nome" SelectionChanged="Parent_Changed"/>
        </StackPanel>
        <TextBlock x:Name="ListTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <DataGrid x:Name="Grid">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="Check_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Lote / área" Binding="{Binding Nome}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Uso" Binding="{Binding Uso}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Área (m²)" Binding="{Binding AreaText}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Matrícula" Binding="{Binding Lot.Matricula}" Width="110" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
