<Window x:Class="GeoPoint.Revit.UI.BuildingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GeoPoint.Revit.UI"
        Title="GeoPoint – Construção existente" Width="1180" Height="760" MinWidth="960" MinHeight="600"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Construção existente (área edificada)"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                   Text="Desenhe o contorno de cada edificação com linhas do Revit (Linha de modelo ou de detalhe) dentro do lote e use 'Adicionar pelas linhas'. O GeoPoint calcula a área de projeção, a área construída, a taxa de ocupação e a distância da edificação até cada divisa (também no memorial e nas pranchas)."/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="Salvar e desenhar na vista" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
                <Button Content="Cancelar" IsCancel="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,6,0" Content="Adicionar pelas linhas desenhadas…" Click="Add_Click"/>
                <Button Margin="0,0,6,0" Content="Atualizar pelas linhas" Click="Update_Click" ToolTip="Relê as linhas da edificação selecionada (depois de editar o desenho)."/>
                <Button Margin="0,0,6,0" Content="Remover" Click="Remove_Click"/>
                <CheckBox x:Name="Setbacks" Content="Cotas de afastamento no desenho" IsChecked="True" VerticalAlignment="Center" Margin="10,0"/>
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="200"/></Grid.RowDefinitions>
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                      SelectionChanged="Grid_SelectionChanged" CellEditEnding="Grid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lote" Binding="{Binding LotName}" IsReadOnly="True" Width="140"/>
                    <DataGridTextColumn Header="Edificação" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="Uso" Binding="{Binding Uso, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="Pavim." Binding="{Binding Pavimentos, UpdateSourceTrigger=LostFocus}" Width="55"/>
                    <DataGridTextColumn Header="Projeção (m²)" Binding="{Binding AreaText}" IsReadOnly="True" Width="95"/>
                    <DataGridTextColumn Header="Construída (m²)" Binding="{Binding Construida, UpdateSourceTrigger=LostFocus}" Width="105"/>
                    <DataGridTextColumn Header="TO (%)" Binding="{Binding ToText}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Menor afast." Binding="{Binding MinText}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" IsReadOnly="True" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" FontWeight="SemiBold" Margin="0,8,0,4" Text="Distância até cada divisa (edificação selecionada)"/>
            <DataGrid Grid.Row="2" x:Name="SetbackGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Divisa" Binding="{Binding Divisa}" Width="90"/>
                    <DataGridTextColumn Header="Lado" Binding="{Binding Lado}" Width="110"/>
                    <DataGridTextColumn Header="Confrontante" Binding="{Binding Confrontante}" Width="*"/>
                    <DataGridTextColumn Header="Distância (m)" Binding="{Binding Distancia}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <ui:PreviewCanvas Grid.Column="2" Grid.RowSpan="3" x:Name="Preview" MinHeight="300"/>
        </Grid>
    </DockPanel>
</Window>
