<Window x:Class="GeoPoint.Revit.UI.ProjectInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoPoint – Dados do imóvel" Width="720" Height="600" MinWidth="560" MinHeight="460"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Dados do imóvel (usados no memorial)" Style="{StaticResource H1}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Campos vazios não aparecem no memorial. Proprietário, matrícula e endereço também podem ser informados por lote no Gerenciador de Lotes."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Salvar" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Proprietário(s):"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" x:Name="Proprietario"/>
                <Label Grid.Row="1" Content="CPF/CNPJ:"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="Documento"/>
                <Label Grid.Row="1" Grid.Column="3" Content="Tipo de imóvel:"/>
                <ComboBox Grid.Row="1" Grid.Column="4" x:Name="Tipo">
                    <ComboBoxItem Content="Urbano"/>
                    <ComboBoxItem Content="Rural"/>
                </ComboBox>
                <Label Grid.Row="2" Content="Denominação:"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" x:Name="Denominacao" ToolTip="Ex.: Lote Urbano, Fazenda Boa Vista, Chácara..."/>
                <Label Grid.Row="3" Content="Endereço / localização:"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" x:Name="Endereco"/>
                <Label Grid.Row="4" Content="Bairro:"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="Bairro"/>
                <Label Grid.Row="4" Grid.Column="3" Content="Município:"/>
                <TextBox Grid.Row="4" Grid.Column="4" x:Name="Municipio"/>
                <Label Grid.Row="5" Content="UF:"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="UF" MaxLength="2" Width="60"/>
                    <Label Content="   CEP:"/>
                    <TextBox x:Name="Cep" Width="110" MaxLength="10"/>
                </StackPanel>
                <Label Grid.Row="5" Grid.Column="3" Content="Comarca:"/>
                <TextBox Grid.Row="5" Grid.Column="4" x:Name="Comarca"/>
                <Label Grid.Row="6" Content="Cartório (CRI):"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="Cartorio"/>
                <Label Grid.Row="6" Grid.Column="3" Content="Matrícula:"/>
                <TextBox Grid.Row="6" Grid.Column="4" x:Name="Matricula"/>
                <Label Grid.Row="7" Content="Inscrição municipal:"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="Inscricao"/>
                <Label Grid.Row="7" Grid.Column="3" Content="CCIR / CAR:"/>
                <StackPanel Grid.Row="7" Grid.Column="4" Orientation="Horizontal">
                    <TextBox x:Name="Ccir" Width="110" ToolTip="CCIR (rural)"/>
                    <TextBox x:Name="Car" Width="150" Margin="6,2,0,2" ToolTip="CAR (rural)"/>
                </StackPanel>
                <Label Grid.Row="8" Content="Finalidade:"/>
                <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="4" x:Name="Finalidade" ToolTip="Ex.: Remembramento de lotes urbanos, Retificação de área..."/>
                <Label Grid.Row="9" Content="RRT / ART nº:"/>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="RrtArt"/>
                <Label Grid.Row="9" Grid.Column="3" Content="Perfil urbanístico:"/>
                <ComboBox Grid.Row="9" Grid.Column="4" x:Name="Profile" ToolTip="Parâmetros (área mínima, testada etc.) usados no quadro de áreas e na verificação. Edite os perfis em Configurações."/>
                <Label Grid.Row="10" Content="Situação:"/>
                <ComboBox Grid.Row="10" Grid.Column="1" x:Name="Situacao" IsEditable="True" ToolTip="Aparece no memorial (subtítulo) e no carimbo da prancha. Escolha ou digite outra."/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
