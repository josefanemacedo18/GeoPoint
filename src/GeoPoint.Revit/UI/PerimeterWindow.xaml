<Window x:Class="GeoPoint.Revit.UI.PerimeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GeoPoint.Revit.UI"
        Title="GeoPoint – Desenhar perímetro (azimutes, coordenadas ou certidão)" Width="1320" Height="880" MinWidth="1040" MinHeight="620"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Desenhar perímetro" Style="{StaticResource H1}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                   Text="Desenhe o contorno do lote por azimutes e distâncias ou pelas coordenadas dos vértices: digite, cole o texto de um memorial (inclusive do SIGEF) ou as linhas de uma planilha, ou importe a certidão. O texto é lido enquanto você digita; a prévia e a conferência aparecem ao lado. As linhas desenhadas servem para o Reconhecer Lotes, que já aplica os confrontantes informados aqui."/>
        <Border DockPanel.Dock="Top" Background="#F4F6F9" BorderBrush="#C9D1DB" BorderThickness="1" Padding="8,5" Margin="0,4,0,6">
            <DockPanel>
                <Button x:Name="ImportBtn" DockPanel.Dock="Left" Margin="0" Style="{StaticResource Primary}" Click="ImportDoc_Click"
                        Content="Importar certidão ou memorial (PDF, foto ou imagem)…"
                        ToolTip="Lê só a descrição do perímetro: coordenadas ou azimutes e distâncias de cada trecho, a divisa (frente, fundos, laterais) e o confrontante. PDF digital: o texto do próprio PDF (exato). PDF escaneado, foto ou imagem: reconhecimento de texto (OCR) no próprio computador – Tesseract, com o do Windows de reserva. Pode escolher vários arquivos (ex.: o memorial e as matrículas): o melhor perímetro é desenhado e os outros servem de conferência."/>
                <TextBlock x:Name="ImportStatus" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="#5F6B7A"
                           Text="Leia o perímetro e os confrontantes direto da certidão ou do memorial. Tudo o que for lido aparece nas tabelas para conferir antes de desenhar."/>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Desenhar" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Desenho e posição">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DetailLines" GroupName="lt" IsChecked="True" Content="Linhas de detalhe (vista atual)"
                                 ToolTip="Padrão do GeoPoint: as linhas aparecem só na vista atual e servem para o Reconhecer Lotes."/>
                    <RadioButton x:Name="ModelLines" GroupName="lt" Content="Linhas de modelo"
                                 ToolTip="As linhas aparecem em todas as vistas de planta do nível."/>
                </StackPanel>
                <WrapPanel>
                    <RadioButton x:Name="PosClick" GroupName="pos" IsChecked="True" Content="Clicar onde fica o primeiro vértice" Checked="Pos_Changed"/>
                    <RadioButton x:Name="PosRef" GroupName="pos" Content="Começar no ponto de referência do projeto" Checked="Pos_Changed"/>
                    <RadioButton x:Name="PosCoord" GroupName="pos" Content="Na posição das coordenadas (usa a referência do projeto)" Checked="Pos_Changed"/>
                </WrapPanel>
                <CheckBox x:Name="SetRef" Content="Usar o primeiro vértice como ponto de referência do projeto (o topo da vista é o norte)"
                          ToolTip="O ponto clicado recebe a coordenada do primeiro vértice: o projeto fica georreferenciado por estas coordenadas."/>
                <TextBlock x:Name="PosNote" Style="{StaticResource Hint}" Margin="4,2,0,0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox DockPanel.Dock="Bottom" Header="Resultado e conferência">
            <TextBlock x:Name="Result" FontFamily="Consolas" TextWrapping="Wrap"/>
        </GroupBox>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                          ToolTip="Arraste para alargar o documento ou a prévia."/>
            <TabControl Grid.Column="2" x:Name="RightTabs">
                <TabItem Header="Prévia (norte para cima)">
                    <Border BorderBrush="#DDD" BorderThickness="1" Margin="2"><ui:PreviewCanvas x:Name="Preview"/></Border>
                </TabItem>
                <TabItem Header="Documento" x:Name="DocTab">
                    <DockPanel Margin="2">
                        <!-- Botões numa linha (tamanho fixo) e a explicação embaixo: a explicação não aperta os botões. -->
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                            <Button Content="−" Width="28" MinWidth="0" Padding="0,2" Margin="0" VerticalAlignment="Center" Click="DocZoomOut_Click" ToolTip="Diminuir"/>
                            <Button Content="+" Width="28" MinWidth="0" Padding="0,2" Margin="3,0,0,0" VerticalAlignment="Center" Click="DocZoomIn_Click" ToolTip="Aumentar"/>
                            <Button Content="Largura" MinWidth="0" Padding="8,2" Margin="3,0,0,0" VerticalAlignment="Center" Click="DocZoomFit_Click" ToolTip="Página inteira na largura do painel"/>
                            <Button Content="Abrir o arquivo" MinWidth="0" Padding="8,2" Margin="3,0,0,0" VerticalAlignment="Center" Click="OpenDoc_Click" ToolTip="Abre o documento no visualizador do Windows."/>
                        </WrapPanel>
                        <ComboBox x:Name="DocPick" DockPanel.Dock="Top" Margin="0,2,0,2" Visibility="Collapsed" SelectionChanged="DocPick_Changed"
                                  ToolTip="Documentos importados: o primeiro é o do desenho; os outros servem de conferência."/>
                        <WrapPanel DockPanel.Dock="Top" Margin="1,2,0,4">
                            <TextBlock Foreground="#5F6B7A" FontSize="11" Text="O que foi lido: " VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" Background="#7FBFE1FF" BorderBrush="#1F6FD0" BorderThickness="1" Margin="2,0,2,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" Text="coordenadas  " VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" Background="#7FFFD27F" BorderBrush="#D07A00" BorderThickness="1" Margin="2,0,2,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" Text="azimutes  " VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" Background="#7FB9F2B0" BorderBrush="#2E8B2E" BorderThickness="1" Margin="2,0,2,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" Text="distâncias e área  " VerticalAlignment="Center"/>
                            <Border Width="10" Height="10" Background="#7FE3C7F5" BorderBrush="#8A3FBF" BorderThickness="1" Margin="2,0,2,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" Text="confrontantes" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" Foreground="#5F6B7A" Text="  – clique numa linha da tabela para ir até ela" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </WrapPanel>
                        <ScrollViewer x:Name="DocScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#EEE"
                                      SizeChanged="DocScroll_SizeChanged">
                            <ui:DocumentView x:Name="DocView" Margin="4"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Diagnóstico" x:Name="DiagTab">
                    <DockPanel Margin="4">
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,6,0,0" Content="Copiar diagnóstico" Click="CopyDiag_Click"
                                ToolTip="Copia um relatório da leitura (sem a imagem, com CPF, documentos e nomes mascarados) para você colar num e-mail ou mensagem."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Etapas da leitura" Margin="0,0,0,2"/>
                                <ItemsControl x:Name="StepsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <TextBlock DockPanel.Dock="Left" Width="18" Text="{Binding Icon}" FontWeight="Bold" Foreground="{Binding Color}"/>
                                                <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Detail, Mode=OneWay}"/></TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock FontWeight="SemiBold" Text="Conferência do perímetro" Margin="0,10,0,2"/>
                                <ItemsControl x:Name="ChecksList" ItemTemplate="{Binding ItemTemplate, ElementName=StepsList}"/>
                                <TextBlock FontWeight="SemiBold" Text="Tentativas de leitura" Margin="0,10,0,2"/>
                                <TextBlock x:Name="AttemptsText" TextWrapping="Wrap" Foreground="#5F6B7A" FontSize="11"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <!-- ============================== AZIMUTES E DISTÂNCIAS -->
                <TabItem Header="Azimutes e distâncias">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="Source" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 TextChanged="Source_TextChanged" FontFamily="Consolas"/>
                        <WrapPanel Grid.Row="1" Margin="0,6,0,6">
                            <Button Content="Modelo de texto" Margin="0" Click="Template_Click" ToolTip="Insere um texto pronto para você só trocar os valores."/>
                            <Button Content="Interpretar texto" Click="Parse_Click" Style="{StaticResource Primary}"/>
                            <Button Content="Adicionar trecho" Click="Add_Click"/>
                            <Button Content="Remover selecionados" Click="Remove_Click"
                                    ToolTip="Remove os trechos selecionados na tabela (Ctrl ou Shift + clique para selecionar vários; a tecla Delete também remove)."/>
                            <Button Content="Remover todos" Click="RemoveAll_Click" ToolTip="Esvazia a tabela de trechos (o texto acima continua)."/>
                            <Button Content="▲ Subir" MinWidth="0" Padding="8,2" Click="Up_Click" ToolTip="Sobe os trechos selecionados uma posição (Alt + ↑)."/>
                            <Button Content="▼ Descer" MinWidth="0" Padding="8,2" Click="Down_Click" ToolTip="Desce os trechos selecionados uma posição (Alt + ↓)."/>
                        </WrapPanel>
                        <Border x:Name="CoordHint" Grid.Row="2" Visibility="Collapsed" Background="#EAF2FB" BorderBrush="#B7CCE6" BorderThickness="1" Padding="8,5" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Desenhar pelas coordenadas" Click="UseCoords_Click"/>
                                <TextBlock x:Name="CoordHintText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="All" SelectionMode="Extended" SelectionUnit="FullRow"
                                  CellEditEnding="Grid_CellEditEnding" SelectionChanged="Row_Selected" PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.RowHeaderTemplate>
                                <DataTemplate>
                                    <TextBlock MinWidth="18" TextAlignment="Right" Foreground="#5F6B7A"
                                               Text="{Binding DataContext.Num, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                </DataTemplate>
                            </DataGrid.RowHeaderTemplate>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Azimute (ex.: 299°36'55&quot;)" Binding="{Binding Az, UpdateSourceTrigger=LostFocus}" Width="140"/>
                                <DataGridTextColumn Header="Distância / corda (m)" Binding="{Binding Dist, UpdateSourceTrigger=LostFocus}" Width="105"/>
                                <DataGridTextColumn Header="Raio (m)" Binding="{Binding Radius, UpdateSourceTrigger=LostFocus}" Width="70"/>
                                <DataGridCheckBoxColumn Header="Arco à dir." Binding="{Binding Right, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                <DataGridTextColumn Header="No formato do projeto" Binding="{Binding Output}" Width="160" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="Testada" Binding="{Binding Testada, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                <DataGridTextColumn Header="Divisa" Binding="{Binding Lado, UpdateSourceTrigger=LostFocus}" Width="85"/>
                                <DataGridTextColumn Header="Confrontante (pode corrigir)" Binding="{Binding Confrontante, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="Trecho encontrado no texto" Binding="{Binding Source}" Width="150" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <CheckBox x:Name="Adjust" Grid.Row="4" Margin="0,6,0,0" Content="Distribuir o erro de fechamento (método de Bowditch) e fechar o polígono" IsChecked="True" Click="Recalc_Click"/>
                    </Grid>
                </TabItem>
                <!-- ============================== COORDENADAS -->
                <TabItem Header="Coordenadas">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,6">
                            <Label Content="Sistema:"/>
                            <ComboBox x:Name="CKind" Width="200" SelectionChanged="Coord_SettingChanged">
                                <ComboBoxItem Content="UTM (E, N em metros)"/>
                                <ComboBoxItem Content="Geográficas (latitude, longitude)"/>
                                <ComboBoxItem Content="Locais (X, Y em metros)"/>
                            </ComboBox>
                            <Label Content="Datum:"/>
                            <ComboBox x:Name="CDatum" Width="130" SelectionChanged="Coord_SettingChanged">
                                <ComboBoxItem Content="SIRGAS 2000"/>
                                <ComboBoxItem Content="WGS 84"/>
                                <ComboBoxItem Content="SAD 69"/>
                                <ComboBoxItem Content="Córrego Alegre"/>
                            </ComboBox>
                            <Label Content="Fuso:"/>
                            <TextBox x:Name="CZone" Width="40" TextChanged="Coord_TextSettingChanged"/>
                            <ComboBox x:Name="CHemi" Width="70" SelectionChanged="Coord_SettingChanged">
                                <ComboBoxItem Content="Sul"/>
                                <ComboBoxItem Content="Norte"/>
                            </ComboBox>
                            <CheckBox x:Name="CClose" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Content="Fechar o polígono (do último ao primeiro)" Click="Recalc_Click"/>
                        </WrapPanel>
                        <TextBox x:Name="CoordSource" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 TextChanged="CoordSource_TextChanged" FontFamily="Consolas"/>
                        <WrapPanel Grid.Row="2" Margin="0,6,0,6">
                            <Button Content="Modelo de texto" Margin="0" Click="CoordTemplate_Click" ToolTip="Insere um trecho de memorial com coordenadas para você trocar os valores."/>
                            <Button Content="Interpretar texto" Click="CoordParse_Click" Style="{StaticResource Primary}"/>
                            <Button Content="Adicionar vértice" Click="CoordAdd_Click"/>
                            <Button Content="Remover selecionados" Click="CoordRemove_Click"
                                    ToolTip="Remove os vértices selecionados na tabela (Ctrl ou Shift + clique para selecionar vários; a tecla Delete também remove)."/>
                            <Button Content="Remover todos" Click="CoordRemoveAll_Click" ToolTip="Esvazia a tabela de vértices (o texto acima continua)."/>
                            <Button Content="▲ Subir" MinWidth="0" Padding="8,2" Click="CoordUp_Click" ToolTip="Sobe os vértices selecionados uma posição (Alt + ↑)."/>
                            <Button Content="▼ Descer" MinWidth="0" Padding="8,2" Click="CoordDown_Click" ToolTip="Desce os vértices selecionados uma posição (Alt + ↓)."/>
                            <Button Content="Inverter sentido" Click="CoordReverse_Click" ToolTip="Percorre os vértices no sentido contrário (o primeiro continua o primeiro)."/>
                        </WrapPanel>
                        <DataGrid x:Name="CGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="All" SelectionMode="Extended" SelectionUnit="FullRow"
                                  CellEditEnding="Grid_CellEditEnding" SelectionChanged="Row_Selected" PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.RowHeaderTemplate>
                                <DataTemplate>
                                    <TextBlock MinWidth="18" TextAlignment="Right" Foreground="#5F6B7A"
                                               Text="{Binding DataContext.Num, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                </DataTemplate>
                            </DataGrid.RowHeaderTemplate>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Bad}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vértice" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="64"/>
                                <DataGridTextColumn x:Name="ColA" Header="E (m)" Binding="{Binding A, UpdateSourceTrigger=LostFocus}" Width="100"/>
                                <DataGridTextColumn x:Name="ColB" Header="N (m)" Binding="{Binding B, UpdateSourceTrigger=LostFocus}" Width="110"/>
                                <DataGridTextColumn Header="Raio (m)" Binding="{Binding Radius, UpdateSourceTrigger=LostFocus}" Width="62"/>
                                <DataGridCheckBoxColumn Header="Arco à dir." Binding="{Binding Right, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                <DataGridTextColumn Header="Até o próximo – no desenho" Binding="{Binding Output}" Width="145" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Conferência" Binding="{Binding Check}" Width="95" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="Testada" Binding="{Binding Testada, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                <DataGridTextColumn Header="Divisa" Binding="{Binding Lado, UpdateSourceTrigger=LostFocus}" Width="85"/>
                                <DataGridTextColumn Header="Confrontante até o próximo (pode corrigir)" Binding="{Binding Confrontante, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="CDetected" Grid.Row="4" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   ToolTip="O desenho usa o azimute verdadeiro e a distância horizontal (plano topográfico local), como o resto do GeoPoint. Distâncias UTM (planas) diferem alguns centímetros; a conferência aceita as duas."/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
