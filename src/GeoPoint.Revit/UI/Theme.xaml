<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <SolidColorBrush x:Key="Accent" Color="#1F5FA8"/>
    <SolidColorBrush x:Key="Muted" Color="#5F6B7A"/>
    <SolidColorBrush x:Key="Panel" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="Border" Color="#C9D1DB"/>
    <SolidColorBrush x:Key="Ok" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Warn" Color="#B26A00"/>
    <SolidColorBrush x:Key="Bad" Color="#C62828"/>

    <Style TargetType="Window" x:Key="GpWindow">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="H1">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,6"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="#DCE8F7"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,2,0,2"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Células com espaço para caixas de seleção e textos (nada cortado). -->
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,3,0,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="0,3,12,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,4,0,6"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Padding" Value="0,4,8,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E3E8EE"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="MinRowHeight" Value="30"/>
        <Setter Property="ColumnHeaderHeight" Value="28"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>

</ResourceDictionary>
