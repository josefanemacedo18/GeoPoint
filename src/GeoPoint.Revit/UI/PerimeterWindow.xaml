<Window x:Class="GeoPoint.Revit.UI.PerimeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GeoPoint.Revit.UI"
        Title="GeoPoint – Desenhar perímetro (azimutes, coordenadas ou certidão)" Width="1320" Height="880" MinWidth="1040" MinHeight="620"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Desenhar perímetro" Style="{StaticResource H1}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                   Text="Desenhe o contorno do lote por azimutes e distâncias ou pelas coordenadas dos vértices: digite, cole o texto de um memorial (inclusive do SIGEF) ou as linhas de uma planilha. O texto é lido enquanto você digita; a prévia e a conferência aparecem ao lado. As linhas desenhadas servem para o Reconhecer Lotes."/>
        <Border DockPanel.Dock="Top" Background="#F4F6F9" BorderBrush="#C9D1DB" BorderThickness="1" Padding="8,5" Margin="0,4,0,6">
            <DockPanel>
                <Button x:Name="ImportBtn" DockPanel.Dock="Left" Margin="0" Style="{StaticResource Primary}" Click="ImportDoc_Click"
                        Content="Importar certidão ou memorial (PDF ou imagem)…"
                        ToolTip="Certidão de inteiro teor, matrícula, memorial ou tabela de coordenadas. PDF digital: o texto do próprio PDF (exato). PDF escaneado, foto ou imagem: reconhecimento de texto (OCR) do Windows, sem enviar o documento para fora do computador."/>
                <TextBlock x:Name="ImportStatus" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="#5F6B7A"
                           Text="Leia o perímetro, os confrontantes e os dados do imóvel direto da certidão. Tudo lido aparece para conferir antes de desenhar."/>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Desenhar" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Desenho e posição">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModelLines" GroupName="lt" IsChecked="True" Content="Linhas de modelo"/>
                    <RadioButton x:Name="DetailLines" GroupName="lt" Content="Linhas de detalhe (vista atual)"/>
                </StackPanel>
                <WrapPanel>
                    <RadioButton x:Name="PosClick" GroupName="pos" IsChecked="True" Content="Clicar onde fica o primeiro vértice" Checked="Pos_Changed"/>
                    <RadioButton x:Name="PosRef" GroupName="pos" Content="Começar no ponto de referência do projeto" Checked="Pos_Changed"/>
                    <RadioButton x:Name="PosCoord" GroupName="pos" Content="Na posição das coordenadas (usa a referência do projeto)" Checked="Pos_Changed"/>
                </WrapPanel>
                <CheckBox x:Name="SetRef" Content="Usar o primeiro vértice como ponto de referência do projeto (o topo da vista é o norte)"
                          ToolTip="O ponto clicado recebe a coordenada do primeiro vértice: o projeto fica georreferenciado por estas coordenadas."/>
                <TextBlock x:Name="PosNote" Style="{StaticResource Hint}" Margin="4,2,0,0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox DockPanel.Dock="Bottom" Header="Resultado e conferência">
            <TextBlock x:Name="Result" FontFamily="Consolas" TextWrapping="Wrap"/>
        </GroupBox>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                          ToolTip="Arraste para alargar o documento ou a prévia."/>
            <TabControl Grid.Column="2" x:Name="RightTabs">
                <TabItem Header="Prévia (norte para cima)">
                    <Border BorderBrush="#DDD" BorderThickness="1" Margin="2"><ui:PreviewCanvas x:Name="Preview"/></Border>
                </TabItem>
                <TabItem Header="Documento" x:Name="DocTab">
                    <DockPanel Margin="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="−" Width="26" Margin="0" Click="DocZoomOut_Click" ToolTip="Diminuir"/>
                                <Button Content="+" Width="26" Margin="2,0" Click="DocZoomIn_Click" ToolTip="Aumentar"/>
                                <Button Content="Largura" Margin="0,0,4,0" Click="DocZoomFit_Click" ToolTip="Página inteira na largura do painel"/>
                                <Button Content="Abrir o arquivo" Margin="0" Click="OpenDoc_Click" ToolTip="Abre o documento no visualizador do Windows."/>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#5F6B7A" FontSize="11"
                                       Text="Em amarelo: os números que entraram no desenho."/>
                        </DockPanel>
                        <ScrollViewer x:Name="DocScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#EEE"
                                      SizeChanged="DocScroll_SizeChanged">
                            <ui:DocumentView x:Name="DocView" Margin="4"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <!-- ============================== AZIMUTES E DISTÂNCIAS -->
                <TabItem Header="Azimutes e distâncias">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="Source" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 TextChanged="Source_TextChanged" FontFamily="Consolas"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,6">
                            <Button Content="Modelo de texto" Margin="0" Click="Template_Click" ToolTip="Insere um texto pronto para você só trocar os valores."/>
                            <Button Content="Interpretar texto" Click="Parse_Click" Style="{StaticResource Primary}"/>
                            <Button Content="Adicionar trecho" Click="Add_Click"/>
                            <Button Content="Remover trecho" Click="Remove_Click"/>
                        </StackPanel>
                        <Border x:Name="CoordHint" Grid.Row="2" Visibility="Collapsed" Background="#EAF2FB" BorderBrush="#B7CCE6" BorderThickness="1" Padding="8,5" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Desenhar pelas coordenadas" Click="UseCoords_Click"/>
                                <TextBlock x:Name="CoordHintText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" CellEditEnding="Grid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Azimute (ex.: 299°36'55&quot;)" Binding="{Binding Az, UpdateSourceTrigger=LostFocus}" Width="170"/>
                                <DataGridTextColumn Header="Distância / corda (m)" Binding="{Binding Dist, UpdateSourceTrigger=LostFocus}" Width="130"/>
                                <DataGridTextColumn Header="Raio (m) – só arcos" Binding="{Binding Radius, UpdateSourceTrigger=LostFocus}" Width="120"/>
                                <DataGridCheckBoxColumn Header="Arco à direita" Binding="{Binding Right, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="No formato do projeto" Binding="{Binding Output}" Width="170" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Trecho encontrado no texto" Binding="{Binding Source}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <CheckBox x:Name="Adjust" Grid.Row="4" Margin="0,6,0,0" Content="Distribuir o erro de fechamento (método de Bowditch) e fechar o polígono" IsChecked="True" Click="Recalc_Click"/>
                    </Grid>
                </TabItem>
                <!-- ============================== COORDENADAS -->
                <TabItem Header="Coordenadas">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,6">
                            <Label Content="Sistema:"/>
                            <ComboBox x:Name="CKind" Width="200" SelectionChanged="Coord_SettingChanged">
                                <ComboBoxItem Content="UTM (E, N em metros)"/>
                                <ComboBoxItem Content="Geográficas (latitude, longitude)"/>
                                <ComboBoxItem Content="Locais (X, Y em metros)"/>
                            </ComboBox>
                            <Label Content="Datum:"/>
                            <ComboBox x:Name="CDatum" Width="130" SelectionChanged="Coord_SettingChanged">
                                <ComboBoxItem Content="SIRGAS 2000"/>
                                <ComboBoxItem Content="WGS 84"/>
                                <ComboBoxItem Content="SAD 69"/>
                                <ComboBoxItem Content="Córrego Alegre"/>
                            </ComboBox>
                            <Label Content="Fuso:"/>
                            <TextBox x:Name="CZone" Width="40" TextChanged="Coord_TextSettingChanged"/>
                            <ComboBox x:Name="CHemi" Width="70" SelectionChanged="Coord_SettingChanged">
                                <ComboBoxItem Content="Sul"/>
                                <ComboBoxItem Content="Norte"/>
                            </ComboBox>
                            <CheckBox x:Name="CClose" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Content="Fechar o polígono (do último ao primeiro)" Click="Recalc_Click"/>
                        </WrapPanel>
                        <TextBox x:Name="CoordSource" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 TextChanged="CoordSource_TextChanged" FontFamily="Consolas"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,6">
                            <Button Content="Modelo de texto" Margin="0" Click="CoordTemplate_Click" ToolTip="Insere um trecho de memorial com coordenadas para você trocar os valores."/>
                            <Button Content="Interpretar texto" Click="CoordParse_Click" Style="{StaticResource Primary}"/>
                            <Button Content="Adicionar vértice" Click="CoordAdd_Click"/>
                            <Button Content="Remover vértice" Click="CoordRemove_Click"/>
                            <Button Content="Inverter sentido" Click="CoordReverse_Click" ToolTip="Percorre os vértices no sentido contrário (o primeiro continua o primeiro)."/>
                        </StackPanel>
                        <DataGrid x:Name="CGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" CellEditEnding="Grid_CellEditEnding">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Bad}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vértice" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="90"/>
                                <DataGridTextColumn x:Name="ColA" Header="E (m)" Binding="{Binding A, UpdateSourceTrigger=LostFocus}" Width="120"/>
                                <DataGridTextColumn x:Name="ColB" Header="N (m)" Binding="{Binding B, UpdateSourceTrigger=LostFocus}" Width="120"/>
                                <DataGridTextColumn Header="Raio até o próximo (m)" Binding="{Binding Radius, UpdateSourceTrigger=LostFocus}" Width="90"/>
                                <DataGridCheckBoxColumn Header="Arco à direita" Binding="{Binding Right, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="Até o próximo – no desenho" Binding="{Binding Output}" Width="190" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Conferência com o texto" Binding="{Binding Check}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="CDetected" Grid.Row="4" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   ToolTip="O desenho usa o azimute verdadeiro e a distância horizontal (plano topográfico local), como o resto do GeoPoint. Distâncias UTM (planas) diferem alguns centímetros; a conferência aceita as duas."/>
                    </Grid>
                </TabItem>
                            <!-- ============================== DADOS DA CERTIDÃO -->
                <TabItem Header="Dados da certidão" x:Name="CertTab">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CertHint" Style="{StaticResource Hint}" Margin="0,0,0,4"
                                   Text="Importe uma certidão para ler os dados do imóvel e os confrontantes. Confira e corrija os valores; os campos marcados vão para os Dados do Imóvel."/>
                        <DataGrid x:Name="CertFields" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Usar" Binding="{Binding Use, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Campo" Binding="{Binding Label}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Lido da certidão (pode corrigir)" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Margin="0,8,0,4" Text="Confrontante de cada divisa (na ordem do perímetro):"/>
                        <DataGrid x:Name="CertConfs" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Divisa" Binding="{Binding Trecho}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Confrontante (pode corrigir)" Binding="{Binding Confrontante, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Testada (rua)" Binding="{Binding Testada, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="4" Margin="0,6,0,0">
                            <CheckBox x:Name="FillInfo" IsChecked="True" Content="Preencher os Dados do Imóvel com os campos marcados"/>
                            <CheckBox x:Name="ReplaceInfo" Margin="22,2,0,2" Content="Substituir também os dados já preenchidos (sem marcar: só os campos vazios)"/>
                            <CheckBox x:Name="RegisterLot" Content="Cadastrar o lote ao desenhar (lote, quadra, matrícula, área e perímetro da certidão e o confrontante de cada divisa)"
                                      ToolTip="O lote já fica pronto, sem precisar de Reconhecer Lotes. Só para polígonos fechados."/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
