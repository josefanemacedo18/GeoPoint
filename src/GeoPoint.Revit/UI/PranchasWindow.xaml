<Window x:Class="GeoPoint.Revit.UI.PranchasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GeoPoint.Revit.UI"
        Title="GeoPoint – Pranchas A4" Width="1000" Height="820" MinWidth="820" MinHeight="640"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Pranchas A4 por situação"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Cada prancha usa uma CÓPIA da planta (o desenho original não é alterado). Pranchas com vários lotes são de visualização (distâncias, áreas, proprietários e confrontantes, sem vértices nem azimutes). Pranchas de um lote têm a numeração própria do lote (P-01…), todos os azimutes e o quadro de coordenadas."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="Gerar pranchas" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Pranchas">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Margin="0" Content="Escolher o ponto de referência no desenho…" Click="PickRef_Click"
                            ToolTip="Selecione a prancha na tabela e clique no vértice (com snap) cuja coordenada vai no carimbo."/>
                </StackPanel>
                <DataGrid x:Name="SheetsGrid" Height="190" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Prancha" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Conteúdo" Binding="{Binding Conteudo}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Coordenada de referência" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding RefOptions}" DisplayMemberPath="Text" SelectedValuePath="Id" SelectedValue="{Binding RefKey, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Já existe" Binding="{Binding Status}" Width="130" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Se já existir" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static ui:SheetRow.ReplaceOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Exists}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <Label Content="Origem:"/>
                    <ComboBox x:Name="Source" DisplayMemberPath="Text" SelectionChanged="Changed"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="LotsTitle" FontWeight="SemiBold" Margin="0,8,0,4" Text="Lotes (situação sem operação: regularização, levantamento...)"/>
                <DataGrid x:Name="LotsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="Changed"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Lote" Binding="{Binding Nome}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding AreaText}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <StackPanel Grid.Column="2">
                <GroupBox Header="Situações">
                    <StackPanel>
                        <CheckBox x:Name="Atual" Content="Situação atual (todos os lotes juntos)" Click="Changed"/>
                        <CheckBox x:Name="IndAtual" Content="Situação atual – cada lote individualmente" Click="Changed"/>
                        <CheckBox x:Name="Proposta" Content="Situação proposta (total)" Click="Changed"/>
                        <CheckBox x:Name="IndProposta" Content="Situação proposta – cada lote individualmente" Click="Changed"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Conteúdo">
                    <StackPanel>
                        <CheckBox x:Name="Anotacoes" Content="Anotações (distâncias, azimutes, vértices com ponto, confrontantes)"/>
                        <CheckBox x:Name="Hachuras" Content="Hachuras (cores por lote; remanescente com hachura cruzada)"/>
                        <CheckBox x:Name="Quadro" Content="Quadro de áreas (pranchas com vários lotes)" Click="Changed"/>
                        <CheckBox x:Name="Coordenadas" Content="Quadro de coordenadas (pranchas de um lote só)" Click="Changed"/>
                        <CheckBox x:Name="Vias" Content="Desenho esquemático das vias (testadas associadas a vias)"/>
                        <CheckBox x:Name="Norte" Content="Girar a cópia para o norte verdadeiro ficar para cima"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Folha A4">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Label Content="Orientação:"/>
                        <ComboBox Grid.Column="1" x:Name="Orientation">
                            <ComboBoxItem Content="Retrato (carimbo embaixo)"/>
                            <ComboBoxItem Content="Paisagem (carimbo à direita)"/>
                        </ComboBox>
                        <Label Grid.Row="1" Content="Escala:"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Scale"/>
                        <Label Grid.Row="2" Content="Numeração:"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="Prefix" ToolTip="Prefixo do número da prancha (ex.: GP → GP-01, GP-02...)."/>
                        <Label Grid.Row="3" Content="Localização:"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="Image" ToolTip="Imagem (PNG/JPG) de localização para o carimbo – ex.: print do Google Earth."/>
                        <Button Grid.Row="3" Grid.Column="2" Content="Escolher…" Click="Image_Click"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
