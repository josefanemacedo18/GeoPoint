<Window x:Class="GeoPoint.Revit.UI.QuadroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoPoint – Quadro de áreas" Width="1150" Height="760" MinWidth="820" MinHeight="520"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="Quadro de áreas e parâmetros urbanísticos" Style="{StaticResource H1}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Label Content="Perfil urbanístico:"/>
                <ComboBox x:Name="Profile" Width="280" SelectionChanged="Profile_Changed"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="ProfileInfo" DockPanel.Dock="Top" Style="{StaticResource Hint}"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Margin="0" Content="Exportar Excel…" Click="Excel_Click"/>
            <Button DockPanel.Dock="Left" Content="Copiar quadro" Click="Copy_Click"/>
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True"/>
        </DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="520"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="Cats" Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Especificação" Binding="{Binding Categoria}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qtde" Binding="{Binding Quantidade}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding AreaText}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="%" Binding="{Binding PctText}" Width="70" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <ScrollViewer Grid.Column="2" Height="200" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Checks" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
            <TextBlock Grid.Row="1" Text="Lotes" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <DataGrid Grid.Row="2" x:Name="LotsGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lote / área" Binding="{Binding Nome}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Uso" Binding="{Binding Uso}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Testada (m)" Binding="{Binding Testada}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Líquida (m²)" Binding="{Binding Liquida}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Edificável (m²)" Binding="{Binding Edificavel}" Width="95" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Projeção máx. (m²)" Binding="{Binding Projecao}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Construção máx. (m²)" Binding="{Binding Construcao}" Width="125" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="220" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
