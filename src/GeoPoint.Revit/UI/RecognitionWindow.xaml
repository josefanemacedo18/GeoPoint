<Window x:Class="GeoPoint.Revit.UI.RecognitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoPoint – Reconhecer lotes" Width="760" Height="640" MinWidth="560" MinHeight="460"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Reconhecimento de áreas a partir das linhas" Style="{StaticResource H1}"/>
        <TextBlock x:Name="Summary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="ShowIssuesButton" DockPanel.Dock="Left" Margin="0" Content="Mostrar no Revit" Click="ShowIssues_Click"
                    ToolTip="Fecha esta janela e seleciona no Revit as linhas do problema escolhido na lista."/>
            <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True"/>
            <Button x:Name="ContinueButton" DockPanel.Dock="Right" Content="Continuar" Style="{StaticResource Primary}" Click="Continue_Click" IsDefault="True"/>
        </DockPanel>

        <GroupBox DockPanel.Dock="Bottom" Header="Como criar os lotes">
            <StackPanel>
                <RadioButton x:Name="ModeClick" GroupName="mode" IsChecked="True"
                             Content="Clicar dentro de cada lote no desenho (Esc termina)"/>
                <RadioButton x:Name="ModeAll" GroupName="mode"
                             Content="Criar de uma vez todas as áreas fechadas ainda não cadastradas"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Numeração inicial:"/>
                    <TextBox Grid.Column="1" x:Name="StartNumber" Text="01" ToolTip="Os lotes recebem números em sequência (01, 02, 03...)."/>
                    <Label Grid.Column="2" Content="  Quadra:"/>
                    <TextBox Grid.Column="3" x:Name="Quadra"/>
                    <Label Grid.Column="4" Content="  Uso:"/>
                    <ComboBox Grid.Column="5" x:Name="Uso" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                </Grid>
                <CheckBox x:Name="IncludeHoles" Content="Considerar áreas internas isoladas (ilhas) como furos do lote"/>
                <CheckBox x:Name="MergeCollinear" Content="Remover vértices intermediários alinhados (linhas emendadas sem encontro de outra linha)"/>
            </StackPanel>
        </GroupBox>

        <TextBlock DockPanel.Dock="Top" Text="Diagnóstico do desenho" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DataGrid x:Name="Grid" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nível" Binding="{Binding Nivel}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ocorrência" Binding="{Binding Mensagem}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Local (X; Y) m" Binding="{Binding Lote}" Width="170" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
