<Window x:Class="GeoPoint.Revit.UI.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoPoint" Width="860" Height="560" MinWidth="520" MinHeight="320"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock x:Name="Header" DockPanel.Dock="Top" Style="{StaticResource H1}"/>
        <TextBlock x:Name="Summary" DockPanel.Dock="Top" Style="{StaticResource Hint}"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="SelectButton" DockPanel.Dock="Left" Content="Mostrar no Revit" Click="Select_Click" Margin="0" ToolTip="Fecha esta janela e seleciona no Revit as linhas do lote/problema escolhido."/>
            <Button DockPanel.Dock="Left" Content="Copiar" Click="Copy_Click" ToolTip="Copia a tabela para colar no Excel."/>
            <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="Fechar" IsCancel="True"/>
            <Button DockPanel.Dock="Right" x:Name="AcceptButton" Content="Aplicar" Style="{StaticResource Primary}" Click="Accept_Click" Visibility="Collapsed"/>
        </DockPanel>
        <DataGrid x:Name="Grid" SelectionMode="Extended" MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nível" Binding="{Binding Nivel}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Lote" Binding="{Binding Lote}" Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="Mensagem" Binding="{Binding Mensagem}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
