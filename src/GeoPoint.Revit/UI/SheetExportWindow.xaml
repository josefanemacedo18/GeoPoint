<Window x:Class="GeoPoint.Revit.UI.SheetExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoPoint – Exportar pranchas em PDF" Width="760" Height="600" MinWidth="600" MinHeight="420"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" Style="{StaticResource H1}" Text="Exportar pranchas em PDF"/>
        <TextBlock DockPanel.Dock="Top" x:Name="HintText" Style="{StaticResource Hint}" TextWrapping="Wrap"
                   Text="Usa a exportação de PDF do próprio Revit, em escala real (100%), no tamanho de papel de cada prancha. Marque as pranchas e escolha a pasta."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="Exportar" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Arquivo" x:Name="FileBox">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="Pasta:"/>
                <TextBox Grid.Column="1" x:Name="Folder"/>
                <Button Grid.Column="2" Content="Escolher…" Click="Folder_Click"/>
                <Label Grid.Row="1" Content="Nome:"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="FileName" ToolTip="Nome do arquivo quando as pranchas vão num PDF só."/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <RadioButton x:Name="Combine" GroupName="c" IsChecked="True" Content="Todas as pranchas num PDF só" Margin="4,6,16,4"/>
                    <RadioButton GroupName="c" Content="Um PDF por prancha" Margin="4,6"/>
                    <CheckBox x:Name="Open" IsChecked="True" Content="Abrir a pasta ao terminar" Margin="16,6,4,4"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,4">
            <Button DockPanel.Dock="Left" Margin="0" Content="Marcar todas" Click="All_Click"/>
            <Button DockPanel.Dock="Left" Content="Desmarcar" Click="None_Click"/>
            <CheckBox x:Name="OnlyGp" IsChecked="True" Content="Só pranchas do GeoPoint" Margin="12,0" VerticalAlignment="Center" Click="Filter_Click"/>
        </DockPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                <DataGridTextColumn x:Name="ColNumber" Header="Número" Binding="{Binding Number}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn x:Name="ColName" Header="Prancha" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn x:Name="ColPaper" Header="Papel" Binding="{Binding PaperText}" IsReadOnly="True" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
