<Window x:Class="GeoPoint.Revit.UI.FasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoPoint – Fases do projeto" Width="900" Height="600" MinWidth="720" MinHeight="460"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoPoint.Revit;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Fases do projeto"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Cada fase parte dos lotes ativos da fase anterior (ex.: 0 – Situação atual → 1 – Remembramento → 2 – Desmembramento) e tem seus próprios lotes, operações, numeração de vértices (começa em P-01), memoriais e pranchas. Cada fase tem uma vista de trabalho; abrir a vista de uma fase torna essa fase a ativa."/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="Salvar nomes" Click="Save_Click" ToolTip="Grava os nomes e situações editados na tabela."/>
        </DockPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Nova fase (a partir da fase selecionada)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="Nome:"/>
                <TextBox Grid.Column="1" x:Name="NewName" Text="Desmembramento"/>
                <Label Grid.Column="2" Content="  Situação:"/>
                <ComboBox Grid.Column="3" x:Name="NewSituacao" IsEditable="True"/>
                <Button Grid.Column="4" Content="Criar fase" Style="{StaticResource Primary}" Click="Create_Click"/>
                <CheckBox Grid.Row="1" Grid.ColumnSpan="5" x:Name="NewView" IsChecked="True" Margin="0,6,0,0"
                          Content="Criar a vista de trabalho da fase (cópia da vista atual) e abri-la"/>
            </Grid>
        </GroupBox>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,6">
            <Button Margin="0" Content="Ativar e abrir a vista" Click="Activate_Click"/>
            <Button Content="Criar vista da fase" Click="CreateView_Click" ToolTip="Para fases sem vista de trabalho (ex.: a Fase 0): cria uma cópia da vista atual."/>
            <Button Content="Atualizar vistas" Click="Refresh_Click" ToolTip="Reaplica a visibilidade das linhas em todas as vistas de fase."/>
            <Button Content="Excluir fase" Click="Delete_Click"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="" Binding="{Binding Ativa}" Width="28" IsReadOnly="True"/>
                <DataGridTextColumn Header="Fase" Binding="{Binding Numero}" Width="45" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Situação" Binding="{Binding Situacao, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridTextColumn Header="Parte de" Binding="{Binding Base}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Lotes ativos" Binding="{Binding Lotes}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Operações" Binding="{Binding Operacoes}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Vistas" Binding="{Binding Vistas}" Width="160" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
